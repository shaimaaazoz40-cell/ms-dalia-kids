rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function active() {
      return request.auth != null && exists(/databases/(default)/documents/users/$(request.auth.uid))
        && get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function isAdmin() {
      return active() && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /schedule/{fileName} {
      allow read: if active();
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
